# ============================================
# ReelDL — Instagram Reel Downloader
# Environment Configuration
# ============================================
# Copy this file to .env and adjust values:
#   cp .env.example .env

# --------------- Server ---------------
# Port to expose nginx on the host machine
PORT=80

# --------------- Frontend ---------------
# Public API URL — leave empty when running in Docker (nginx proxies /api → backend).
# Set this only for local development or when the frontend is hosted on a separate domain.
NEXT_PUBLIC_API_URL=

# Public site URL — used for sitemap generation, canonical URLs, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost

# --------------- Backend ---------------
# Comma-separated list of allowed CORS origins. Use * during development only.
ALLOWED_ORIGINS=*

# --------------- Redis ---------------
# Redis connection settings (defaults match the docker-compose service name).
REDIS_HOST=redis
REDIS_PORT=6379

# --------------- Rate Limiting ---------------
# Maximum requests per minute per IP address.
RATE_LIMIT_EXTRACT=10
RATE_LIMIT_DOWNLOAD=5

# --------------- Extraction ---------------
# Absolute path to the yt-dlp binary (the Docker image installs it here).
YTDLP_PATH=/usr/local/bin/yt-dlp

# Maximum time (seconds) to wait for yt-dlp to finish before killing the process.
EXTRACTION_TIMEOUT=20

# How long (minutes) to cache extraction results in Redis.
CACHE_TTL_MINUTES=30

# Maximum video file size in bytes that the /api/download endpoint will stream.
# Default: 104857600 (100 MB).
MAX_VIDEO_SIZE=104857600

# --------------- Domain & SSL (Production) ---------------
# When deploying behind Cloudflare:
#   1. Point your domain's DNS A record to your server's public IP (orange-cloud proxied).
#   2. In Cloudflare SSL/TLS settings, set mode to "Full".
#   3. Update the variables below:
#        ALLOWED_ORIGINS=https://yourdomain.com
#        NEXT_PUBLIC_SITE_URL=https://yourdomain.com
#   Cloudflare terminates SSL; nginx listens on port 80 inside the container.

