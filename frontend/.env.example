# ============================================
# ReelDL Frontend — Environment Configuration
# ============================================
# When deployed on Vercel:
# Set this to your Render backend web service URL (without trailing slash).
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Canonical URL for OpenGraph and Sitemap metadata
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

